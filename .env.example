# Gitpush - GitHub Repository & Atomic Git Push Manager
#
# Gitpush, GitHub token'ını (PAT) uygulama arayüzünden ister ve ASLA .env
# dosyasında saklamaz. Bu dosyaya token, API anahtarı veya parola YAZMAYIN.
#
# UYARI: "VITE_" önekiyle başlayan her değişken derlenen JavaScript'e gömülür ve
# tarayıcıda herkes tarafından okunabilir. Gizli bilgileri asla VITE_ ile tanımlamayın.

# Optional Environment Variables (gizli olmayan ayarlar)
# VITE_GITHUB_DEFAULT_BRANCH="main"
# APP_URL: The URL where this applet is hosted
APP_URL="http://localhost:3000"
